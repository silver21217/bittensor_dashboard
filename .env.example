# TaoStats API keys (comma-separated, rotated per request)
# Get keys at https://taostats.io — free tier ~5 RPM/key, paid 60 RPM/key.
# See README for how many keys are needed to sustain dashboard polling.
TAOSTATS_KEYS=tao-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:xxxxxxxx,tao-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:xxxxxxxx

# JWT signing secret for session cookies. Falls back to a hard-coded dev
# default in src/lib/auth/session.ts when unset — DO set this in prod.
AUTH_SECRET=replace-with-long-random-string

# Optional override paths for persistence files. Defaults shown.
# SERIES_STORE_PATH=.data/series-store.json
# CACHE_STORE_PATH=.data/cache-store.json
